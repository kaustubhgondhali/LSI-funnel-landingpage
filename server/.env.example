# Copy to .env and fill in — or just run setup.bat, which writes .env for you.
# Never upload .env anywhere public: it holds the database password.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lordsai_sip
DB_USER=lordsai_app
DB_PASSWORD=

# Pages allowed to send data to this API (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://kaustubhgondhali.github.io

PORT=5000

# When hosting (Render, Railway, a VPS):
# HOST=0.0.0.0
# TRUST_PROXY=1
